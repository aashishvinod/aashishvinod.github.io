---
import { getExperienceById } from "@/data/experience";
import type { ExperienceEntry } from "@/data/types";

interface Props {
  ids?: string[];
}

const { ids = [] } = Astro.props;
const related: ExperienceEntry[] = ids
  .map((id: string) => getExperienceById(id))
  .filter((e: ExperienceEntry | undefined): e is ExperienceEntry => !!e);
---

{
  related.length > 0 && (
    <div class="space-y-4">
      <h4 class="text-xl font-semibold text-[var(--white)]">Related experience</h4>
      <ul class="flex flex-col gap-3">
        {related.map((entry: ExperienceEntry) => (
          <li>
            <a
              href={`/experience#${entry.id}`}
              class="flex flex-col gap-1 p-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[var(--white-icon)] transition-colors"
            >
              <span class="text-[var(--white)] font-medium">{entry.role}</span>
              <span class="text-sm text-[var(--white-icon)]">
                {entry.organization} · {entry.dates}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
