---
interface Props {
  label?: string;
  class?: string;
}

const { label = "Visual coming soon", class: className = "" } = Astro.props;
---

<div
  class={`flex flex-col items-center justify-center gap-2 w-full h-full min-h-[10rem] bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl text-[var(--white-icon)] ${className}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" class="opacity-50">
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
    <circle cx="8.5" cy="10" r="1.5" fill="currentColor"></circle>
    <path d="M4 16.5L9 12.5L13 15.5L16 12.5L20 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="text-xs">{label}</span>
</div>
