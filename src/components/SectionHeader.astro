---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-8">
  <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">{eyebrow}</h2>
  <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)]">{title}</h3>
  {description && <p class="mt-4 max-w-2xl text-[var(--white-icon)]">{description}</p>}
</div>
